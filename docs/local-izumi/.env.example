# Copy to `.env` (same directory) before `docker compose up`.
# Values here are read by docker-compose.yml interpolation; anything you add
# is also injected verbatim into the izumi-agent container.

# REQUIRED: project used for Vertex AI (Gemini / Imagen / Veo / Lyria) calls.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Bucket for agent artifacts (ADK GcsArtifactService). Reuse Creative Studio's
# GENMEDIA_BUCKET. Leave empty to keep artifacts in memory.
ASSET_SERVICE_GCS_BUCKET=

# Model endpoints; upstream Izumi defaults to the global endpoint.
GOOGLE_CLOUD_LOCATION=global
MODEL_TARGET_LOCATION=global

# Creative Studio endpoints as seen from inside the docker network.
CREATIVE_STUDIO_BACKEND_URL=http://backend:8080
CREATIVE_STUDIO_FRONTEND_URL=http://localhost:4200
# Must match AGENT_ENGINE_USER_AUTH_TOKEN_KEY in Creative Studio's backend/.env
CREATIVE_STUDIO_USER_AUTH_TOKEN_KEY=user_auth_token
